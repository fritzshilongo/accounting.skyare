APP_NAME="Skyare"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://skyare.space
APP_BASE_DOMAIN=skyare.space

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=your_database
DB_USERNAME=your_username
DB_PASSWORD=your_password

CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_DRIVER=sync

MAIL_MAILER=smtp
MAIL_HOST=mail.skyare.space
MAIL_PORT=465
MAIL_USERNAME=support@skyare.space
MAIL_PASSWORD=your_mail_password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="support@skyare.space"
MAIL_FROM_NAME="Skyare"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="Skyare"

# The tenant subdomain that can issue licenses from the UI.
# Use 'www' for the main account domain, or set 'license' if your issuer tenant is license.skyare.space
APP_LICENSE_ISSUER_SUBDOMAIN=license
